# ---------------------------------------------------------------------------
# Vercel (backend) – set these in Vercel Dashboard → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ---------------------------------------------------------------------------
# Frontend (local / GitHub Pages build) – optional for local dev
# ---------------------------------------------------------------------------
# Base URL of your Vercel deployment (no trailing slash). No API key here.
# After deploying the API to Vercel, set this to e.g. https://your-project.vercel.app
# VITE_CHAT_API_BASE_URL=https://your-project.vercel.app
